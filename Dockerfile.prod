# study-platform-client 빌드 (운영, main branch) — Next16 + Turbopack
# 최적화:
#   ① 의존성 레이어 분리 — package.json/yarn.lock 변경이 없으면 yarn install 레이어가 통째로 캐시됨
#   ② yarn cache buildkit 캐시 — lockfile 변경 시에도 패키지 다운로드 재사용
#   ③ .next/cache buildkit 캐시 — turbopack 증분 빌드
#   ④ Next standalone output — runner 중복 yarn install 제거 + 이미지 경량화

ARG APP_RELEASE=unavailable
ARG APP_COMMIT=unavailable
ARG APP_BUILD_ID=unavailable
ARG APP_BUILT_AT=unavailable
ARG APP_CHANNEL=unavailable

# 1단계: build
FROM node:20-alpine AS builder
WORKDIR /app

ENV YARN_CACHE_FOLDER=/usr/local/share/.cache/yarn

# 의존성 레이어 (소스보다 먼저 — 의존성 불변 시 install 캐시 hit)
COPY package.json yarn.lock ./
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn \
    yarn install --frozen-lockfile --prefer-offline

# 릴리스마다 달라지는 빌드 신원은 의존성 설치 뒤에 선언한다.
# 이 값이 바뀌어도 yarn install 레이어 캐시를 유지한다.
ARG APP_RELEASE
ARG APP_COMMIT
ARG APP_BUILD_ID
ARG APP_BUILT_AT
ARG APP_CHANNEL

ENV NEXT_PUBLIC_APP_RELEASE=${APP_RELEASE} \
    NEXT_PUBLIC_APP_COMMIT=${APP_COMMIT} \
    NEXT_PUBLIC_APP_BUILD_ID=${APP_BUILD_ID} \
    NEXT_PUBLIC_APP_BUILT_AT=${APP_BUILT_AT} \
    NEXT_PUBLIC_APP_CHANNEL=${APP_CHANNEL}

# 소스 + 빌드 (.next/cache 는 buildkit 캐시 마운트로 재사용 → 증분)
COPY . .
COPY .env .env
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN --mount=type=cache,target=/app/.next/cache yarn build

# 2단계: runtime (standalone — yarn install 불필요)
FROM node:20-alpine AS runner
WORKDIR /app

ARG APP_RELEASE
ARG APP_COMMIT
ARG APP_BUILD_ID
ARG APP_BUILT_AT
ARG APP_CHANNEL

ENV NODE_ENV=production
ENV PORT=13755
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_APP_RELEASE=${APP_RELEASE} \
    NEXT_PUBLIC_APP_COMMIT=${APP_COMMIT} \
    NEXT_PUBLIC_APP_BUILD_ID=${APP_BUILD_ID} \
    NEXT_PUBLIC_APP_BUILT_AT=${APP_BUILT_AT} \
    NEXT_PUBLIC_APP_CHANNEL=${APP_CHANNEL}

# standalone 산출물만 복사
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# 빌드 시 인라인된 NEXT_PUBLIC_* 외 server-side env 는 런타임 env_file(compose)로 주입된다.
COPY --from=builder /app/.env .env

EXPOSE 13755

CMD ["node", "server.js"]
