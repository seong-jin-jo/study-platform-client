# SPRINT8 E2E 고정 데이터 식별자 (dev 기준)
#
# 왜 이 파일이 있나: 값들이 docs/qa/sprint8-*.md 15개 문서에 흩어져 있었고
# 라운드마다 값이 갱신되면서 서로 충돌했다(예: GH_026_MEMBER_ID 가 981410 과
# 981415 두 값으로 문서에 남아 있다). 실행자가 어느 값을 쓸지 알 수 없어
# 식별자 미설정으로 8건이 실패했다(2026-08-21 전수 실행). 최신 라운드 값을
# 여기 하나로 모은다. 값이 바뀌면 이 파일을 고치고 문서는 이 파일을 가리킨다.
#
# 사용: set -a; source e2e/sprint8-identifiers.env; set +a; yarn e2e

E2E_BASE_URL=https://test.zeroone.it.kr
E2E_API_BASE_URL=https://test-api.zeroone.it.kr

E2E_SPRINT8_FIRST_SLUG=index-made-query-slower
E2E_SPRINT8_FIRST_TITLE='인덱스를 붙였는데 쿼리가 더 느려졌다'
E2E_SPRINT8_FIRST_ISLAND_SLUG=database
E2E_SPRINT8_SECOND_SLUG=short-transaction-long-lock-wait
E2E_SPRINT8_OG_SLUG=index-made-query-slower
E2E_SPRINT8_LOCKED_SLUG=short-transaction-long-lock-wait
E2E_SPRINT8_LOCKED_TITLE='트랜잭션이 짧은데도 락 대기가 길었던 이유'
E2E_SPRINT8_LOCKED_ISLAND_ID=1
E2E_SPRINT8_PAID_SLUG=short-transaction-long-lock-wait
E2E_SPRINT8_COMPLETION_LONG_SLUG=deploy-finished-service-not-ready
E2E_SPRINT8_COMPLETION_SHORT_SLUG=short-transaction-long-lock-wait
E2E_SPRINT8_KOAN_ID=981101
E2E_SPRINT8_GH_040_CATEGORY_SLUG=network-security

# 회원 식별자 (최신 라운드 = round6)
E2E_SPRINT8_AUTH_MEMBER_ID=981409
E2E_SPRINT8_GH_B_MEMBER_ID=981407
E2E_SPRINT8_HAPPY_B_MEMBER_ID=981407
E2E_SPRINT8_GH_017_MEMBER_ID=981411
E2E_SPRINT8_GH_021_MEMBER_ID=981412
E2E_SPRINT8_GH_022_MEMBER_ID=981413
E2E_SPRINT8_GH_024_MEMBER_ID=981414
E2E_SPRINT8_GH_026_MEMBER_ID=981415
E2E_SPRINT8_GH_033_MEMBER_ID=981416
E2E_SPRINT8_QNA_MEMBER_ID=981417
E2E_SPRINT8_QNA_PAGE_PATH=/community/questions/981417
# 이 값은 dev 에 실제로 저장된 값 그대로다. 값을 바꿔도 소용이 없다.
# 문제는 테스트 값이 아니라 **dev 시드 데이터**다. 질문 981417 의 fileUri 가
# '/images/og-image.png' 로 저장돼 있는데, 백엔드가 조회 시점에 그 값을 거부한다
# (2026-08-21 실측: GET /community/questions/981417 -> 400 CMM001
#  "fileUri는 null이거나 '/'로 시작할 수 없습니다"). 즉 저장은 됐는데 읽을 수 없는
# 데이터다. 시드를 선행 슬래시 없이 다시 넣어야 TC-S8-REG-005 가 실행된다.
E2E_SPRINT8_QNA_IMAGE_PATH=/images/og-image.png

# ── 아직 채울 수 없는 값 ──────────────────────────────────────────
# 아래 4종은 CMS 본문에서 뽑는 선택 식별자다. 기본 첫 글은 V114가 CMS에 없는
# test-db 3건을 RETIRED 처리한 뒤 실제 CMS 글 index-made-query-slower로 수렴한다.
# E2E_SPRINT8_FIRST_BODY_FRAGMENT=
# E2E_SPRINT8_FIRST_END_CTA=
# E2E_SPRINT8_LOCKED_BODY_FRAGMENT=
# E2E_SPRINT8_LOCKED_CANARY=
#
# 아래 3종은 발행 콘솔·미디어 픽스처 경로로, 소유자 확인이 필요하다.
# E2E_SPRINT8_PUBLISH_CONSOLE_PATH=
# E2E_SPRINT8_MEDIA_JSON=
# 잔액 0 회원. 테스트가 실제로 읽는 이름은 E2E_SPRINT8_GH_025_MEMBER_ID 다
# (sprint8-happy-a.spec.ts:32). 기본값 981406 은 잔액이 0 이 아니라 5 라 쓸 수 없다.
# 2026-08-26 재조사: 981407(qa-s8-happy-b-zero-budget)이 잔액 0 이다. 실측으로
# GET /api/v1/insight/reading-budget/me -> balance 0, dailyCap 5 를 확인했다.
# 이 케이스는 잔액을 소비하지 않는다(첫 편은 무료). 그래서 happy-b 회원과 겸용해도
# 서로 전제를 깨지 않는다.
E2E_SPRINT8_GH_025_MEMBER_ID=981301
# E2E_SPRINT8_ZERO_BALANCE_LOCKED_SLUG=
