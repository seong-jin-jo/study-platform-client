# study-platform-client 빌드 (dev/QA, develop branch) — Next16 + Turbopack
# 최적화:
#   ① 의존성 레이어 분리 — package.json/yarn.lock 변경이 없으면 yarn install 레이어가 통째로 캐시됨
#   ② yarn cache buildkit 캐시 — lockfile 변경 시에도 패키지 다운로드 재사용
#   ③ Next standalone output — runner 중복 yarn install 제거 + 이미지 경량화
#
# NOTE: turbopack .next/cache 증분 캐시 마운트는 의도적으로 사용하지 않는다.
#   해당 캐시가 stale 해지면 인증 가드 기반 어드민 라우트(예: /admin/sales-management/*)가
#   정적 not-found(404)로 굳어 배포되는 문제가 있었다. force-dynamic 설정·소스 변경으로도
#   BuildKit 캐시 마운트는 비워지지 않아(영속), 매 빌드를 클린하게 수행해 라우트 분류를
#   항상 정확히(dynamic) 생성한다.

# 1단계: build
FROM node:20-alpine AS builder
WORKDIR /app

ENV YARN_CACHE_FOLDER=/usr/local/share/.cache/yarn

# 의존성 레이어 (소스보다 먼저 — 의존성 불변 시 install 캐시 hit)
COPY package.json yarn.lock ./
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn \
    yarn install --frozen-lockfile --prefer-offline

# 소스 + 빌드 (증분 캐시 미사용 — 위 NOTE 참고. 매 빌드 클린)
COPY . .
COPY .env .env
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN yarn build

# 2단계: runtime (standalone — yarn install 불필요)
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=14855
ENV HOSTNAME=0.0.0.0

# standalone 산출물만 복사
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# 빌드 시 인라인된 NEXT_PUBLIC_* 외 server-side env 는 런타임 env_file(compose)로 주입된다.
COPY --from=builder /app/.env .env

EXPOSE 14855

CMD ["node", "server.js"]
